<?xml version="1.0" encoding="utf-8"?>
<!--
  Flare is consumed the way any other library is - from nuget.org, which is also the only source a CI
  runner has. To restore from packages built in a local Flare checkout, add that folder as a user-level
  source instead of here (dotnet nuget add source <Flare>/artifacts -n flare-artifacts), so this file
  stays valid on every machine.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
