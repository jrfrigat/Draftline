<?xml version="1.0" encoding="utf-8"?>
<!--
  Flare is consumed the way any other library is - from NuGet. The second source is the packages
  built in the Flare repository next door: it is what makes a restore work on a machine without
  network, and it is why the versions in the csproj files are pinned to versions that exist.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="flare-artifacts" value="C:\Job\Projects\FrigaT\Flare\artifacts" />
  </packageSources>
</configuration>
