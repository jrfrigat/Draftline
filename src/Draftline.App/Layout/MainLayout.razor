@inherits LayoutComponentBase

@* The editor owns its ribbon and branding. Keep only the full-height content and the shared overlay
   providers here, so a second header does not take space away from the canvas. *@
<FlareLayout>
    <FlareLayoutContent FillHeight="true">
        @Body
    </FlareLayoutContent>

    <FlareDialogProvider />
    <FlareSnackbarProvider />
</FlareLayout>
