@page "/"
@implements IAsyncDisposable
@inject DocumentSession Session
@inject AutosaveService Autosave
@inject FallbackBrowserStorage Storage
@inject IJSRuntime Js

<PageTitle>@Session.Document.Name — Draftline</PageTitle>
<nav class="df-skip-links" aria-label="Быстрый переход">
    <a href="#df-canvas">К холсту</a>
    <a href="#df-properties">К свойствам</a>
</nav>

@* The editor on Flare's IDE shell: the ribbon carries the document's actions, the panels dock at the
   sides, the sheet owns the middle and the status line says what is open and what just happened. The
   shell lives on the page rather than in MainLayout because the ribbon's actions are the page's - undo,
   export, preview - and so is the canvas they act on.

   While the wireframe is being previewed both panel regions fold to their rails: the same "the
   constructor is off" the preview promises, done by the frame's own means, and the view comes back on
   the way out. *@
<div class="@(Session.IsPreviewing ? "df-editor-host df-editor--preview" : "df-editor-host")">
<FlareIdeLayout id="df-editor" LeftPanelWidth="14rem"
                RightPanelWidth="18rem"
                LeftCollapsed="_blocksFolded"
                LeftCollapsedChanged="SetBlocksFolded"
                RightCollapsed="_sidesFolded"
                RightCollapsedChanged="SetSidesFolded">
    <Ribbon>
        @if (!Session.IsPreviewing)
        {
        <div class="df-ribbon-shell">
            <div class="df-ribbon-brand">
                <img src="draftline.svg" alt="" width="20" height="20" />
                <span>Draftline</span>
            </div>
        <FlareRibbon Class="df-ribbon">
            <FlareRibbonTab Title="Макет">
                <FlareRibbonGroup Label="Документ">
                    <ProjectMenu Ready="_ready" />
                </FlareRibbonGroup>
                <FlareRibbonGroup Label="Правка">
                    <FlareRibbonButton Label="Найти в макете" Tooltip="Поиск по макету (Ctrl+F)" Disabled="Session.IsPreviewing" OnClick="Session.ShowSearch" />
                    <FlareRibbonButton Label="Отменить" Tooltip="Шаг назад"
                                       Disabled="@(!Session.CanUndo)" OnClick="Undo" />
                    <FlareRibbonButton Label="Повторить" Tooltip="Шаг вперёд"
                                       Disabled="@(!Session.CanRedo)" OnClick="Redo" />
                </FlareRibbonGroup>
            </FlareRibbonTab>

            <FlareRibbonTab Title="Блок">
                <SelectionCommands />
            </FlareRibbonTab>

            <FlareRibbonTab Title="Файл">
                <FlareRibbonGroup Label="Обмен">
                    <FlareRibbonButton Label="Экспорт SVG" Tooltip="Открытый экран как рисунок"
                                       Disabled="@(Session.Document.TotalElements == 0)" OnClick="ExportSvg" />
                    <FlareRibbonButton Label="Все экраны в SVG" Tooltip="Все экраны в одном ZIP-архиве SVG"
                                       Disabled="@(Session.Document.Layers.Count < 2)" OnClick="ExportAllSvg" />
                    <FlareRibbonButton Label="Экспорт PNG" Disabled="_exporting" OnClick="@(() => ExportDrawing(false, false))" />
                    <FlareRibbonButton Label="Все экраны в PNG" Disabled="_exporting" OnClick="@(() => ExportDrawing(false, true))" />
                    <FlareRibbonButton Label="Экспорт PDF" Disabled="_exporting" OnClick="@(() => ExportDrawing(true, false))" />
                    <FlareRibbonButton Label="Все экраны в PDF" Disabled="_exporting" OnClick="@(() => ExportDrawing(true, true))" />
                    <FlareRibbonButton Label="Выгрузить JSON" Tooltip="Макет в файл" OnClick="ExportJson" />
                    <FlareRibbonButton Label="Загрузить JSON" Tooltip="Макет из файла" OnClick="ImportJson" />
                </FlareRibbonGroup>
            </FlareRibbonTab>

            <FlareRibbonTab Title="Вид">
                <FlareRibbonGroup Label="Оформление конструктора"><ThemePicker Editor="true" /></FlareRibbonGroup>
                <FlareRibbonGroup Label="Оформление макета"><ThemePicker /></FlareRibbonGroup>
                <FlareRibbonGroup Label="Режим">
                    <FlareRibbonButton Label="@(Session.IsPreviewing ? "К редактору" : "Просмотр")"
                                       Tooltip="Показать макет так, как его увидит человек"
                                       OnClick="TogglePreview" />
                </FlareRibbonGroup>
                <FlareRibbonGroup Label="Панели">
                    <FlareRibbonButton Label="@(_blocksFolded ? "Показать блоки" : "Скрыть блоки")"
                                       Disabled="Session.IsPreviewing" OnClick="@(() => SetBlocksFolded(!_blocksFolded))" />
                    <FlareRibbonButton Label="@(_sidesFolded ? "Показать свойства и экраны" : "Скрыть свойства и экраны")"
                                       Disabled="Session.IsPreviewing" OnClick="@(() => SetSidesFolded(!_sidesFolded))" />
                </FlareRibbonGroup>
            </FlareRibbonTab>
        </FlareRibbon>
        </div>
        }
        else
        {
            <div class="df-preview-brand"><img src="draftline.svg" width="20" height="20" alt="" />Draftline</div>
        }
    </Ribbon>

    <LeftToolPanel>
        <section aria-label="Палитра блоков">
        <FlareToolPanel Title="Блоки" Position="ToolPanelPosition.Left">
            <BlockPalette AddRequested="AddBlock" />
        </FlareToolPanel>
        </section>
    </LeftToolPanel>

    <ChildContent>
        <section class="df-stage" aria-label="Холст макета">
            @if(Session.SearchOpen){<DocumentSearchPanel />}
            @if (Session.IsPreviewing)
            {
                <PreviewSurface />
            }
            else
            {
                <MockupThemeScope><CanvasView @ref="_canvas" /></MockupThemeScope>
            }
        </section>
    </ChildContent>

    <RightToolPanel>
        <section id="df-properties" tabindex="-1" aria-label="Свойства и экраны">
        @* These panels own their expanded state independently. Registering both as the IDE layout's
           right tool panel makes their different titles continuously invalidate the same region. *@
        <FlareAccordion AllowMultiple="true">
            <FlareAccordionPanel Header="Свойства" @bind-Expanded="_propertiesExpanded">
                <Inspector />
            </FlareAccordionPanel>
            <FlareAccordionPanel Header="Экраны" @bind-Expanded="_layersExpanded">
                <LayerPanel />
            </FlareAccordionPanel>
            <FlareAccordionPanel Header="Блоки на экране">
                <BlockList />
            </FlareAccordionPanel>
            <FlareAccordionPanel Header="Компоненты">
                <ComponentLibrary />
            </FlareAccordionPanel>
            <FlareAccordionPanel Header="Варианты экрана">
                <AlternatePanel />
            </FlareAccordionPanel>
        </FlareAccordion>
        </section>
    </RightToolPanel>

    <StatusBar>
        <div class="df-status">
            <span class="df-status__name">@Session.Document.Name</span>
            <span>@Session.CurrentLayer.Name</span>
            <span>@Session.Document.TotalElements блоков · @Session.Document.Layers.Count экранов</span>
            @if (Session.Selection.Count > 0)
            {
                <span title="Стрелки — сдвиг, Ctrl+D — копия, Delete — удалить">
                    Выбрано: @Session.Selection.Count · Стрелки / Ctrl+D / Delete
                </span>
            }
            <span class="df-status__note" role="status">@Autosave.Message</span>
            @if (_notice is not null)
            {
                <span role="status">@_notice</span>
                <button type="button" aria-label="Скрыть уведомление" @onclick="() => _notice = null">×</button>
            }
            @if (Storage.IsVolatile)
            {
                <span role="status">Временное хранилище: выгрузите JSON до закрытия вкладки</span>
            }
        </div>
    </StatusBar>
</FlareIdeLayout>
</div>

@code {
    [Inject]
    private DocumentFileService Files { get; set; } = null!;

    [Inject]
    private ProjectCatalog Catalog { get; set; } = null!;

    private CanvasView? _canvas;
    private string? _notice;
    private bool _ready;
    private bool _initializing;
    private bool _compact;
    private bool _wasPreviewing;
    private (bool Blocks, bool Sides) _beforePreview;
    private IJSObjectReference? _viewportModule;
    private IJSObjectReference? _lifecycleModule;
    private DotNetObjectReference<Home>? _lifecycleReference;

    /// <summary>Whether the block shelf is folded to its rail.</summary>
    private bool _blocksFolded;

    /// <summary>Whether the properties and screens are folded to their rail.</summary>
    private bool _sidesFolded;

    // Keep each panel's choice when preview temporarily unmounts the right region.
    private bool _propertiesExpanded = true;
    private bool _layersExpanded = true;

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        Session.Changed += OnSessionChanged;
        Session.GestureChanged += OnGestureChanged;
        Autosave.Changed += OnSaveChanged;
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        Session.Changed -= OnSessionChanged;
        Session.GestureChanged -= OnGestureChanged;
        Autosave.Changed -= OnSaveChanged;
        if (_viewportModule is not null) await _viewportModule.DisposeAsync();
        if (_lifecycleModule is not null)
        {
            await _lifecycleModule.InvokeVoidAsync("detach");
            await _lifecycleModule.DisposeAsync();
        }
        _lifecycleReference?.Dispose();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_initializing) return;
        _initializing = true;

        try
        {
            _viewportModule = await Js.InvokeAsync<IJSObjectReference>("import", "./js/draftline-canvas.js");
            _compact = await _viewportModule.InvokeAsync<bool>("isCompactViewport");
            (_blocksFolded, _sidesFolded) = (_compact, _compact);
            await Storage.ProbeAsync();
            var lastId = await Catalog.LastOpenIdAsync();
            var result = string.IsNullOrWhiteSpace(lastId) ? null : await Catalog.LoadAsync(lastId);
            if (result?.Document is { } document)
            {
                Session.Open(document);
            }
            else
            {
                _notice = result?.Error;
                var fresh = DraftDocument.CreateNew(await Catalog.SuggestNameAsync());
                Session.Open(fresh);
                if (result is null)
                {
                    await Catalog.SaveAsync(fresh);
                    await Catalog.RememberLastAsync(fresh.Id);
                }
            }
        }
        catch (Exception exception)
        {
            _notice = "Не удалось открыть сохранённый макет: " + exception.Message;
            Session.Open(DraftDocument.CreateNew("Восстановление"));
        }

        _ready = true;
        _lifecycleModule = await Js.InvokeAsync<IJSObjectReference>("import", "./js/draftline-lifecycle.js");
        _lifecycleReference = DotNetObjectReference.Create(this);
        await _lifecycleModule.InvokeVoidAsync("attach", _lifecycleReference);
        await UpdateDirtyWarning();
        StateHasChanged();
    }

    [JSInvokable] public Task<bool> SaveBeforeHide() { Session.EndGesture(); return Autosave.FlushAsync(); }

    private bool? _warnedDirty;
    private void OnGestureChanged() => _ = UpdateDirtyWarning();
    private async Task UpdateDirtyWarning()
    {
        if (_lifecycleModule is null || _warnedDirty == Session.IsDirty) return;
        _warnedDirty = Session.IsDirty;
        try { await _lifecycleModule.InvokeVoidAsync("setDirty", Session.IsDirty); }
        catch (JSException) { /* The page may already be closing. */ }
    }

    private void OnSaveChanged() => InvokeAsync(StateHasChanged);

    private void SetBlocksFolded(bool folded)
    {
        _blocksFolded = folded;
        if (_compact && !folded) _sidesFolded = true;
    }

    private void SetSidesFolded(bool folded)
    {
        _sidesFolded = folded;
        if (_compact && !folded) _blocksFolded = true;
    }

    /// <summary>A block asked for from the palette lands in a cascade, not on top of the last one.</summary>
    private void AddBlock(WireframeKind kind) => _canvas?.AddCascade(kind);

    private void Undo() => Session.Undo();

    private void Redo() => Session.Redo();

    /// <summary>
    /// Shows the wireframe the way its reader will see it, or goes back to the editor. The walk lives in
    /// the session, so the canvas and the preview are two faces of one state rather than two editors.
    /// </summary>
    private void TogglePreview()
    {
        if (Session.IsPreviewing)
        {
            Session.ExitPreview();
        }
        else
        {
            Session.EnterPreview();
        }
    }

    /// <summary>The whole sheet as a drawing. One block on its own is exported from the inspector.</summary>
    private Task ExportSvg() => FileOperation(() => Files.DownloadSvgAsync(Session.Document, Session.CurrentLayer), "SVG подготовлен");

    private async Task FileOperation(Func<Task> action, string success)
    {
        try { await action(); _notice = success; }
        catch (Exception exception) { _notice = "Операция с файлом не выполнена: " + exception.Message; }
    }

    private bool _exporting;
    private async Task ExportDrawing(bool pdf, bool all)
    {
        if (_exporting) return;
        _exporting = true; _notice = "Подготовка экспорта…";
        try
        {
            await Files.DownloadDrawingAsync(Session.Document, all ? Session.Document.Layers : new[] { Session.CurrentLayer }, pdf);
            _notice = pdf ? "PDF подготовлен" : "PNG подготовлен";
        }
        catch (Exception) { _notice = "Не удалось экспортировать макет. Попробуйте меньший размер экрана."; }
        finally { _exporting = false; }
    }

    private Task ExportJson() => FileOperation(() => Files.DownloadJsonAsync(Session.Document), "JSON подготовлен");

    /// <summary>Every screen of the wireframe, one file each.</summary>
    private Task ExportAllSvg() => FileOperation(() => Files.DownloadAllSvgAsync(Session.Document), "SVG всех экранов подготовлены");

    /// <summary>
    /// Takes a wireframe out of a file. A file that is not a wireframe is an ordinary answer to asking
    /// for one, so its reason is shown beside the buttons rather than thrown at the person.
    /// </summary>
    private async Task ImportJson()
    {
        try { await ImportJsonCore(); }
        catch (Exception exception) { _notice = "Не удалось импортировать макет: " + exception.Message; }
    }

    private async Task ImportJsonCore()
    {
        var result = await Files.ImportAsync();

        if (result is null)
        {
            return;
        }

        if (result.Document is null)
        {
            _notice = result.Error;
            return;
        }

        // An imported wireframe is written into this browser straight away: it arrived from a file, and
        // until it is saved the editor is holding something the project list does not know about.
        var imported = await Catalog.PrepareImportAsync(result.Document);
        if (!await Autosave.FlushAsync()) { _notice = Autosave.Message; return; }
        await Catalog.SaveAsync(imported);
        await Catalog.RememberLastAsync(imported.Id);
        Session.Open(imported);
        Session.MarkSaved("Загружено из файла: " + imported.Name);

        _notice = null;
    }

    private void OnSessionChanged()
    {
        _ = UpdateDirtyWarning();
        if (Session.IsPreviewing != _wasPreviewing)
        {
            if (Session.IsPreviewing)
            {
                _beforePreview = (_blocksFolded, _sidesFolded);
                (_blocksFolded, _sidesFolded) = (true, true);
            }
            else
            {
                (_blocksFolded, _sidesFolded) = _beforePreview;
            }
            _wasPreviewing = Session.IsPreviewing;
        }

        InvokeAsync(StateHasChanged);
    }
}
