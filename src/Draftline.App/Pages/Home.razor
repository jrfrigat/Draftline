@page "/"
@implements IDisposable
@inject DocumentSession Session

<PageTitle>@Session.Document.Name — Draftline</PageTitle>

@* The editor: the shelf of blocks on the left, the sheet in the middle, the properties of what is
   selected on the right. The strip above the sheet says what is open and what just happened - the
   same line carries the storage's word once it is wired in. *@
<div class="df-editor">
<aside class="df-side df-side--palette" aria-label="Экраны и блоки">
        <h2 class="df-side__title">Экраны</h2>
        <LayerPanel OnExportAllRequested="ExportAllSvg" />

        <h2 class="df-side__title">Блоки</h2>
        <BlockPalette AddRequested="AddBlock" />
    </aside>

    <section class="df-main" aria-label="Холст макета">
        <div class="df-toolbar">
            <ProjectMenu />
            <span class="df-toolbar__spacer"></span>
            <FlareButton Variant="ButtonVariant.Text" Disabled="@(!Session.CanUndo)" OnClick="Undo">
                Отменить
            </FlareButton>
            <FlareButton Variant="ButtonVariant.Text" Disabled="@(!Session.CanRedo)" OnClick="Redo">
                Повторить
            </FlareButton>

            <FlareButton Variant="ButtonVariant.Text" Disabled="@(Session.Document.TotalElements == 0)"
                         OnClick="ExportSvg">
                Экспорт SVG
            </FlareButton>
            <FlareButton Variant="ButtonVariant.Text" OnClick="ExportJson">Выгрузить JSON</FlareButton>
            <FlareButton Variant="ButtonVariant.Text" OnClick="ImportJson">Загрузить JSON</FlareButton>

            @if (_notice is not null)
            {
                <span class="df-toolbar__notice">@_notice</span>
            }
        </div>
        <CanvasView @ref="_canvas" />
    </section>

    <aside class="df-side df-side--inspector" aria-label="Свойства">
        <h2 class="df-side__title">Свойства</h2>
        <Inspector />
    </aside>
</div>

@code {
    [Inject]
    private DocumentFileService Files { get; set; } = null!;

    [Inject]
    private ProjectCatalog Catalog { get; set; } = null!;

    private CanvasView? _canvas;
    private string? _notice;

    /// <inheritdoc />
    protected override void OnInitialized() => Session.Changed += OnSessionChanged;

    /// <inheritdoc />
    public void Dispose() => Session.Changed -= OnSessionChanged;

    /// <summary>A block asked for from the palette lands in a cascade, not on top of the last one.</summary>
    private void AddBlock(WireframeKind kind) => _canvas?.AddCascade(kind);

    private void Undo() => Session.Undo();

    private void Redo() => Session.Redo();

    /// <summary>The whole sheet as a drawing. One block on its own is exported from the inspector.</summary>
    private Task ExportSvg() => Files.DownloadSvgAsync(Session.Document, Session.CurrentLayer);

    private Task ExportJson() => Files.DownloadJsonAsync(Session.Document);

    /// <summary>Every screen of the wireframe, one file each.</summary>
    private Task ExportAllSvg() => Files.DownloadAllSvgAsync(Session.Document);

    /// <summary>
    /// Takes a wireframe out of a file. A file that is not a wireframe is an ordinary answer to asking
    /// for one, so its reason is shown beside the buttons rather than thrown at the person.
    /// </summary>
    private async Task ImportJson()
    {
        var result = await Files.ImportAsync();

        if (result is null)
        {
            return;
        }

        if (result.Document is null)
        {
            _notice = result.Error;
            return;
        }

        // An imported wireframe is written into this browser straight away: it arrived from a file, and
        // until it is saved the editor is holding something the project list does not know about.
        Session.Open(result.Document);
        await Catalog.SaveAsync(result.Document);
        await Catalog.RememberLastAsync(result.Document.Id);
        Session.MarkSaved("Загружено из файла: " + result.Document.Name);

        _notice = null;
    }

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);
}
