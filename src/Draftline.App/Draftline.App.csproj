<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Draftline.App</RootNamespace>
    <AssemblyName>Draftline.App</AssemblyName>
    <!-- The editor is a client-only PWA: no backend, no API, no server state. Documents live in the
         browser and the app shell is cached by wwwroot/service-worker.published.js. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <BlazorWebAssemblyLoadAllGlobalizationData>false</BlazorWebAssemblyLoadAllGlobalizationData>
    <!-- The published worker is only substituted for the development one when the SDK has an assets
         manifest to rewrite - the manifest is also the file the worker reads to know what the build
         actually contains, so a first visit can fill the offline cache in one go. -->
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- Flare: the component library, the IDE shell and registered design systems. Fluent UI 2 is the default
         because it is the tighter of the presets - a wireframing tool wants canvas, not padding. The
         theme brings its own tokens package, so nothing else is referenced for it. The IDE package is
         the shell the editor page is built on: dockable tool panels, a ribbon, a status line. Versions
         are pinned to the versions this machine can restore, and they are the same version across the
         Flare packages on purpose - two of them drifting apart is a broken theme. -->
    <PackageReference Include="Flare.Blazor" Version="0.48.0" />
    <PackageReference Include="Flare.Components.IDE" Version="0.48.0" />
    <PackageReference Include="Flare.Theme.FluentUI2" Version="0.48.0" />
    <PackageReference Include="Flare.Theme.MaterialDesign3Expressive" Version="0.48.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Flare.Theme.OneC\Flare.Theme.OneC.csproj" />
    <!-- Two workers, one path: the development one does nothing (a cache is the last thing a
         developer wants while typing), the published one is the offline shell the PWA promises. -->
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

</Project>
