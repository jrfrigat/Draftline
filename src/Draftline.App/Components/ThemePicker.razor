@using Draftline.App.Theming
@inject DocumentSession Session
@inject ThemeCoordinator Themes
@implements IDisposable
<div class="df-theme-fields">
    <FlareSelect Label="@(Editor?"Тема конструктора":"Тема макета")" Size="FieldSize.Xs" Value="@(Editor?Themes.Editor.CurrentTheme.Id:Session.Document.MockupTheme.ThemeId)" ValueChanged="@((string? value)=>Change("theme",value))">
        @if(!Editor){<option value="wireframe">Черновой макет</option>}
        <option value="@(Editor?"draftline-fluent2":"fluent2")">Fluent UI 2</option>
        <option value="@(Editor?"draftline-md3e":"md3-expressive")">Material Design 3 Expressive</option>
    </FlareSelect>
    <FlareSelect Label="@(Editor?"Палитра конструктора":"Палитра макета")" Size="FieldSize.Xs" Value="@(Editor?Themes.Editor.CurrentPalette.Id:Session.Document.MockupTheme.PaletteId)" ValueChanged="@((string? value)=>Change("palette",value))" Disabled="@(!Editor && Session.Document.MockupTheme.ThemeId=="wireframe")">
        <option value="fluent-blue">Синяя</option><option value="fluent-excel">Зелёная</option><option value="fluent-teams">Фиолетовая</option>
    </FlareSelect>
    <FlareSelect Label="@(Editor?"Режим конструктора":"Режим макета")" Size="FieldSize.Xs" Value="@(Editor?Themes.Editor.Mode.ToString().ToLowerInvariant():Session.Document.MockupTheme.Mode)" ValueChanged="@((string? value)=>Change("mode",value))" Disabled="@(!Editor && Session.Document.MockupTheme.ThemeId=="wireframe")">
        <option value="light">Светлый</option><option value="dark">Тёмный</option><option value="auto">Как в системе</option>
    </FlareSelect>
</div>
@code {
    [Parameter] public bool Editor{get;set;}
    protected override void OnInitialized(){Themes.Changed+=Refresh;Session.Changed+=Refresh;}
    private void Refresh()=>InvokeAsync(StateHasChanged);
    public void Dispose(){Themes.Changed-=Refresh;Session.Changed-=Refresh;}
    private async Task Change(string axis,string? value)
    {
        if(value is null)return;
        if(Editor)
        {
            if(axis=="theme")await Themes.Editor.SetThemeAsync(value);
            else if(axis=="palette")await Themes.Editor.SetPaletteAsync(value);
            else await Themes.Editor.SetModeAsync(ThemeCoordinator.EditorMode(value));
        }
        else Session.Edit("Тема макета изменена",_=>{var selection=Session.Document.MockupTheme;if(axis=="theme")selection.ThemeId=value;else if(axis=="palette")selection.PaletteId=value;else selection.Mode=value;selection.Normalize();});
    }
}
