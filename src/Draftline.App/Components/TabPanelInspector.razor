@inject DocumentSession Session

@if (TabPanels.IsContainer(Element.Kind))
{
    <FlareTextField Label="Название контейнера" Size="FieldSize.Xs" Value="@Element.Text"
                    ValueChanged="Rename" />
    <FlareTextArea @key="@(Element.Id + "/" + TabPanels.Index(Element))"
                   Label="@($"Содержимое панели «{ElementDefaults.SplitOption(ElementState.Items(Element)[TabPanels.Index(Element)]).Label}»")"
                   Size="FieldSize.Xs" Value="@TabPanels.Content(Element)" ValueChanged="SetContent" />
    <p class="df-hint">Выберите заголовок на холсте. Блок из палитры добавится в открытую панель.
        У существующего блока можно выбрать контейнер и панель в свойствах.</p>
}
else if (Session.CurrentLayer.Elements.Any(e => TabPanels.IsContainer(e.Kind)))
{
    <FlareSelect Label="Контейнер" Size="FieldSize.Xs" Value="@Element.ParentTabsId" ValueChanged="@((string? value) => SetParent(value))">
        <option value="">На холсте</option>
        @foreach (var tabs in Session.CurrentLayer.Elements.Where(e => TabPanels.IsContainer(e.Kind)))
        {
            <option value="@tabs.Id">@(string.IsNullOrWhiteSpace(tabs.Text) ? ElementDefaults.NameOf(tabs.Kind) + " " + (Session.CurrentLayer.Elements.Where(e => TabPanels.IsContainer(e.Kind)).ToList().IndexOf(tabs) + 1) : tabs.Text)</option>
        }
    </FlareSelect>
    @if (TabPanels.Parent(Session.CurrentLayer, Element) is { } parent)
    {
        <FlareSelect Label="Панель блока" Size="FieldSize.Xs" Value="@Element.ParentTabIndex.ToString()" ValueChanged="@((string? value) => SetIndex(value))">
            @for (var i = 0; i < ElementState.Items(parent).Count; i++)
            {
                <option value="@i">@(i + 1). @ElementDefaults.SplitOption(ElementState.Items(parent)[i]).Label</option>
            }
        </FlareSelect>
    }
}

@code {
    /// <summary>The block whose panel content or membership is being edited.</summary>
    [Parameter, EditorRequired] public WireframeElement Element { get; set; } = null!;

    private void Rename(string? value)
    {
        if (Element.Text == (value ?? string.Empty)) return;
        Session.Edit("Контейнер переименована", _ => Element.Text = value ?? string.Empty);
    }

    private void SetContent(string? value)
    {
        if (TabPanels.Content(Element) == (value ?? string.Empty)) return;
        Session.Edit("Содержимое панели изменено", _ => TabPanels.SetContent(Element, value ?? string.Empty));
    }

    private void SetParent(string? id) => Session.AssignToTab(Element.Id, id,
        Session.CurrentLayer.Find(id) is { } parent ? TabPanels.Index(parent) : 0);

    private void SetIndex(string? value)
    {
        if (int.TryParse(value, out var index)) Session.AssignToTab(Element.Id, Element.ParentTabsId, index);
    }
}
