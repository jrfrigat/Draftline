@inject DocumentSession Session
@inject DocumentFileService Files
@implements IDisposable

<FlareRibbonGroup Label="Блок">
    <FlareRibbonButton Label="Дублировать" Tooltip="Копия выбранного блока (Ctrl+D)"
                       Disabled="@SelectionDisabled" OnClick="Duplicate" />
    <FlareRibbonButton Label="Удалить" Tooltip="Удалить выделенные блоки (Delete)"
                       Disabled="@SelectionDisabled" OnClick="Remove" />
    <FlareRibbonButton Label="SVG блока" Tooltip="Выделенные блоки в SVG"
                       Disabled="@SelectionDisabled" OnClick="Export" />
</FlareRibbonGroup>
<FlareRibbonGroup Label="Группа">
    <FlareRibbonButton Label="Сгруппировать" Disabled="@(Session.IsPreviewing || Session.Selection.Count < 2)" OnClick="Session.GroupSelected" />
    <FlareRibbonButton Label="Разгруппировать" Disabled="@(Session.IsPreviewing || Session.SelectedGroupId.Length == 0)" OnClick="Session.UngroupSelected" />
    <FlareRibbonButton Label="Войти в группу" Disabled="@(Session.IsPreviewing || Session.SelectedGroupId.Length == 0)" OnClick="@(() => Session.EnterGroup())" />
</FlareRibbonGroup>
<FlareRibbonGroup Label="Выравнивание по холсту">
    @foreach (var (alignment, caption) in Alignments)
    {
        var target = alignment;
        <FlareRibbonButton Label="@caption" Tooltip="@($"{caption} относительно холста")"
                           Disabled="@SelectionDisabled" OnClick="@(() => Align(target))" />
    }
</FlareRibbonGroup>
<FlareRibbonGroup Label="Размер">
    <FlareRibbonButton Label="Во всю ширину" Tooltip="Растянуть блок по ширине холста"
                       Disabled="@SingleDisabled" OnClick="@(() => Align(ElementAlignment.MatchWidth))" />
    <FlareRibbonButton Label="Во всю высоту" Tooltip="Растянуть блок по высоте холста"
                       Disabled="@SingleDisabled" OnClick="@(() => Align(ElementAlignment.MatchHeight))" />
</FlareRibbonGroup>
<FlareRibbonGroup Label="Порядок">
    <FlareRibbonButton Label="На передний план" Tooltip="Поверх остальных блоков"
                       Disabled="@SelectionDisabled" OnClick="Session.BringSelectedToFront" />
    <FlareRibbonButton Label="На задний план" Tooltip="Позади остальных блоков"
                       Disabled="@SelectionDisabled" OnClick="Session.SendSelectedToBack" />
</FlareRibbonGroup>

@code {
    protected override void OnInitialized() => Session.Changed += OnChanged;
    public void Dispose() => Session.Changed -= OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);

    private bool SingleDisabled => Session.IsPreviewing || Session.Selected is null;
    private bool SelectionDisabled => Session.IsPreviewing || Session.Selection.Count == 0;

    private static readonly (ElementAlignment Alignment, string Caption)[] Alignments =
    {
        (ElementAlignment.Left, "Влево"),
        (ElementAlignment.CenterHorizontally, "По центру горизонтально"),
        (ElementAlignment.Right, "Вправо"),
        (ElementAlignment.Top, "Вверх"),
        (ElementAlignment.CenterVertically, "По центру вертикально"),
        (ElementAlignment.Bottom, "Вниз")
    };

    private void Duplicate() => Session.DuplicateSelected();
    private void Remove() => Session.RemoveSelected();

    private Task Export() => Files.DownloadSelectionSvgAsync(Session.Document, Session.CurrentLayer, Session.Members().Select(e=>e.Id));

    private void Align(ElementAlignment alignment)
    {
        if (SelectionDisabled) return;
        if (Session.Selected is not { } element) { Session.AlignSelection(alignment); return; }

        Session.Edit("Выравнивание", _ =>
        {
            if (Session.CurrentLayer.Find(element.Id) is not { } target) return;
            var bounds = CanvasGeometry.Align(target.Bounds, alignment, Session.Document.GridSize,
                Session.CurrentLayer.CanvasWidth, Session.CurrentLayer.CanvasHeight);
            var children = TabPanels.WithChildren(Session.CurrentLayer, new[] { target.Id })
                .Where(child => child.Id != target.Id).ToList();
            var delta = TabPanels.ClampTranslation(children.Select(child => child.Bounds).Append(bounds.With(x: target.X, y: target.Y)),
                bounds.X - target.X, bounds.Y - target.Y, Session.CurrentLayer.CanvasWidth, Session.CurrentLayer.CanvasHeight);
            foreach (var child in children) { child.X += delta.X; child.Y += delta.Y; }
            (target.X, target.Y, target.Width, target.Height) =
                (target.X + delta.X, target.Y + delta.Y, bounds.Width, bounds.Height);
        });
    }
}
