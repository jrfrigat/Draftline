@inject DocumentSession Session
@inject DocumentFileService Files
@implements IDisposable

<FlareRibbonGroup Label="Буфер">
    <RibbonCommand Label="Копировать" Icon="copy" Tooltip="Копировать блоки (Ctrl+C)" Disabled="@SelectionDisabled" OnClick="@(() => Session.CopySelection())" />
    <RibbonCommand Label="Вырезать" Icon="cut" Tooltip="Вырезать блоки (Ctrl+X)" Disabled="@SelectionDisabled" OnClick="@(() => Session.CutSelection())" />
    <RibbonCommand Label="Вставить" Icon="paste" Tooltip="Вставить блоки (Ctrl+V)" Disabled="@(Session.IsPreviewing || !Session.CanPaste)" OnClick="@(() => Session.PasteSelection())" />
</FlareRibbonGroup>
<FlareRibbonGroup Label="Блок">
    <RibbonCommand Label="@(Session.Members().Any(e => e.Locked) ? "Разблокировать" : "Заблокировать")" Icon="@(Session.Members().Any(e => e.Locked) ? "unlock" : "lock")" Pressed="@(Session.Members().Any(e => e.Locked))" Disabled="@SelectionDisabled" OnClick="@(() => Session.LockSelection(!Session.Members().Any(e => e.Locked)))" />
    <RibbonCommand Label="Скрыть" Icon="hide" Disabled="@SelectionDisabled" OnClick="Session.HideSelection" />
    <RibbonCommand Label="Дублировать" Icon="copy" Tooltip="Копия выбранного блока (Ctrl+D)"
                       Disabled="@SelectionDisabled" OnClick="Duplicate" />
    <RibbonCommand Label="Удалить" Icon="delete" Tooltip="Удалить выделенные блоки (Delete)"
                       Disabled="@SelectionDisabled" OnClick="Remove" />
    <RibbonCommand Label="SVG блока" Icon="download" Caption="SVG" Tooltip="Выделенные блоки в SVG"
                       Disabled="@SelectionDisabled" OnClick="Export" />
</FlareRibbonGroup>
<FlareRibbonGroup Label="Группа">
    <RibbonCommand Label="Сгруппировать" Icon="group" Disabled="@(Session.IsPreviewing || Session.Selection.Count < 2)" OnClick="Session.GroupSelected" />
    <RibbonCommand Label="Разгруппировать" Icon="ungroup" Disabled="@(Session.IsPreviewing || Session.SelectedGroupId.Length == 0)" OnClick="Session.UngroupSelected" />
    <RibbonCommand Label="Войти в группу" Icon="enter" Disabled="@(Session.IsPreviewing || Session.SelectedGroupId.Length == 0)" OnClick="@(() => Session.EnterGroup())" />
</FlareRibbonGroup>
<FlareRibbonGroup Label="Выравнивание по холсту">
    @foreach (var (alignment, caption, icon) in Alignments)
    {
        var target = alignment;
        <RibbonCommand Label="@caption" Icon="@icon" Tooltip="@($"{caption} относительно холста")"
                           Disabled="@(!Session.CanTransformSelection || Session.IsPreviewing)" OnClick="@(() => Align(target))" />
    }
</FlareRibbonGroup>
<FlareRibbonGroup Label="Размер">
    <RibbonCommand Label="Равные интервалы по горизонтали" Icon="distribute-h" Disabled="@(Session.IsPreviewing || !Session.CanDistribute)" OnClick="@(() => Session.DistributeSelection(true))" />
    <RibbonCommand Label="Равные интервалы по вертикали" Icon="distribute-v" Disabled="@(Session.IsPreviewing || !Session.CanDistribute)" OnClick="@(() => Session.DistributeSelection(false))" />
    <RibbonCommand Label="Во всю ширину" Icon="width" Tooltip="Растянуть блок по ширине холста"
                       Disabled="@SingleDisabled" OnClick="@(() => Align(ElementAlignment.MatchWidth))" />
    <RibbonCommand Label="Во всю высоту" Icon="height" Tooltip="Растянуть блок по высоте холста"
                       Disabled="@SingleDisabled" OnClick="@(() => Align(ElementAlignment.MatchHeight))" />
</FlareRibbonGroup>
<FlareRibbonGroup Label="Порядок">
    <RibbonCommand Label="На передний план" Icon="front" Tooltip="Поверх остальных блоков"
                       Disabled="@SelectionDisabled" OnClick="Session.BringSelectedToFront" />
    <RibbonCommand Label="На задний план" Icon="back" Tooltip="Позади остальных блоков"
                       Disabled="@SelectionDisabled" OnClick="Session.SendSelectedToBack" />
</FlareRibbonGroup>

@code {
    protected override void OnInitialized() => Session.Changed += OnChanged;
    public void Dispose() => Session.Changed -= OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);

    private bool SingleDisabled => Session.IsPreviewing || Session.Selected is null || !Session.CanTransformSelection;
    private bool SelectionDisabled => Session.IsPreviewing || Session.Selection.Count == 0;

    private static readonly (ElementAlignment Alignment, string Caption, string Icon)[] Alignments =
    {
        (ElementAlignment.Left, "Влево", "left"),
        (ElementAlignment.CenterHorizontally, "По центру горизонтально", "center-h"),
        (ElementAlignment.Right, "Вправо", "right"),
        (ElementAlignment.Top, "Вверх", "top"),
        (ElementAlignment.CenterVertically, "По центру вертикально", "center-v"),
        (ElementAlignment.Bottom, "Вниз", "bottom")
    };

    private void Duplicate() => Session.DuplicateSelected();
    private void Remove() => Session.RemoveSelected();

    private Task Export() => Files.DownloadSelectionSvgAsync(Session.Document, Session.CurrentLayer, Session.Members().Select(e=>e.Id));

    private void Align(ElementAlignment alignment)
    {
        if (SelectionDisabled || !Session.CanTransformSelection) return;
        if (Session.Selected is not { } element) { Session.AlignSelection(alignment); return; }

        Session.Edit("Выравнивание", _ =>
        {
            if (Session.CurrentLayer.Find(element.Id) is not { } target) return;
            var bounds = CanvasGeometry.Align(target.Bounds, alignment, Session.Document.GridSize,
                Session.CurrentLayer.CanvasWidth, Session.CurrentLayer.CanvasHeight);
            var children = TabPanels.WithChildren(Session.CurrentLayer, new[] { target.Id })
                .Where(child => child.Id != target.Id).ToList();
            var delta = TabPanels.ClampTranslation(children.Select(child => child.Bounds).Append(bounds.With(x: target.X, y: target.Y)),
                bounds.X - target.X, bounds.Y - target.Y, Session.CurrentLayer.CanvasWidth, Session.CurrentLayer.CanvasHeight);
            foreach (var child in children) { child.X += delta.X; child.Y += delta.Y; }
            (target.X, target.Y, target.Width, target.Height) =
                (target.X + delta.X, target.Y + delta.Y, bounds.Width, bounds.Height);
        });
    }
}
