<FlareTooltip Content="@Description" Placement="Placement.Bottom">
    <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm"
                 Class="df-ribbon-command" AriaLabel="@Label"
                 title="@Description" AriaPressed="Pressed" Selected="@(Pressed == true)"
                 Disabled="Disabled" OnClick="OnClick">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <path d="@Path" />
        </svg>
        @if (Caption is not null) { <span class="df-ribbon-command__caption">@Caption</span> }
    </FlareButton>
</FlareTooltip>

@code {
    /// <summary>Command name used by assistive technology and the tooltip.</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    /// <summary>Optional explanation including a keyboard shortcut.</summary>
    [Parameter] public string? Tooltip { get; set; }
    /// <summary>Local SVG symbol name.</summary>
    [Parameter, EditorRequired] public string Icon { get; set; } = "";
    /// <summary>Short visible label for commands that need a format or qualifier.</summary>
    [Parameter] public string? Caption { get; set; }
    /// <summary>Whether the command is unavailable.</summary>
    [Parameter] public bool Disabled { get; set; }
    /// <summary>Toggle state, omitted for ordinary commands.</summary>
    [Parameter] public bool? Pressed { get; set; }
    /// <summary>Invokes the command.</summary>
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }

    private string Description => Tooltip is null ? Label : $"{Label} — {Tooltip}";
    private string Path => Icon switch
    {
