@implements IAsyncDisposable
@inject IJSRuntime Js
@inject DocumentSession Session
@inject PaletteDrag Palette

@* The sheet, and everything that happens on it.
   JavaScript reports where the pointer is and which key was pressed; every decision - what was
   grabbed, what it does, what gets selected - is made here in C#, where the document lives. That is
   why this component is the only place that knows the canvas has gestures at all. *@
<div class="df-canvas-host">
    <div class="df-canvas-toolbar" role="toolbar" aria-label="Масштаб и навигация холста">
        <button type="button" aria-label="Уменьшить масштаб" @onclick="() => ZoomBy(-.1)">−</button>
        <output aria-live="polite">@Math.Round(_zoom * 100)%</output>
        <button type="button" aria-label="Увеличить масштаб" @onclick="() => ZoomBy(.1)">+</button>
        <button type="button" @onclick="ResetZoom">100%</button>
        <button type="button" @onclick="FitWidth">По ширине</button>
        <button type="button" aria-pressed="@_hand" @onclick="ToggleHand">Рука</button>
    </div>
    @if (_placementNotice is not null) { <p role="status">@_placementNotice</p> }
    @if (Session.EditingGroupId.Length > 0)
    { <div class="df-group-breadcrumb"><span>Редактирование группы</span><button type="button" @onclick="() => Session.LeaveGroup()">Выйти из группы (Esc)</button></div> }
    <p id="df-canvas-help" class="df-visually-hidden">Ctrl и стрелки выбирают блоки. Стрелки перемещают выделение. F2 меняет текст. Delete удаляет. Escape снимает выделение.</p>
    <div id="df-canvas" class="@("df-sheet" + (_hand ? " df-sheet--hand" : ""))" @ref="_sheet" tabindex="0" style="@SheetStyle"
         role="listbox" aria-label="@("Холст: " + Session.CurrentLayer.Name)" aria-multiselectable="true"
         aria-describedby="df-canvas-help" aria-activedescendant="@(Session.Selection.FirstOrDefault() is { } active ? "df-option-" + active : null)">
        @{ var drawOrder = 0; }
        @foreach (var element in TabPanels.Visible(Session.CurrentLayer))
        {
            <div id="@("df-option-" + element.Id)" role="option" aria-selected="@Session.Selection.Contains(element.Id)"
                 aria-label="@(ElementDefaults.NameOf(element.Kind) + ": " + element.DisplayText + (element.Locked ? ", положение заблокировано" : ""))">
            <WireframeElementView Element="element" DrawingOrder="@(drawOrder++)" Authoring="true" TabSelected="@(index => Session.SelectTab(element.Id, index))"
                                  TreeSelected="@(index => Session.SelectTreeNode(element.Id, index))" Edited="@(action => Session.Edit("Меню изменено", _ => action(element)))" />
            </div>
        }

        @if (Session.SelectionBounds is { } selectionBounds)
        {
            <div class="df-selection @(Session.SelectedGroupId.Length > 0 ? "df-selection--group" : "")" style="@(RectStyle(selectionBounds) + (Session.Selected is { } rotated ? $"transform:rotate({Number(rotated.Rotation)}deg);" : ""))">
                @foreach (var (handle, x, y) in CanResize ? CanvasInteraction.HandlesOf(selectionBounds) : Array.Empty<(ResizeHandle, double, double)>())
                {
                    <span class="df-handle df-handle--@HandleClass(handle)"
                          style="@HandleStyle(selectionBounds, x, y)"></span>
                }
            </div>
        }

        @if (_verticalGuide is { } gx) { <div class="df-smart-guide" style="left:@(Number(gx))px;top:0;width:1px;height:100%"></div> }
        @if (_horizontalGuide is { } gy) { <div class="df-smart-guide" style="top:@(Number(gy))px;left:0;height:1px;width:100%"></div> }
        @if (_marquee is { } frame)
        {
            <div class="df-marquee" style="@RectStyle(frame)"></div>
        }
        @if (_editingId is { } editingId && Session.CurrentLayer.Find(editingId) is { } editing)
        {
            <div class="df-inline-editor" style="@RectStyle(editing.Bounds)">
                <TextEditorField @key="editingId" Label="Изменить текст" AutoFocus="true"
                                 Value="@editing.DisplayText" ValueChanged="@(value => CommitText(editingId, value))"
                                 Completed="CloseTextEditor" />
            </div>
        }
    </div>
    <p class="df-visually-hidden" role="status" aria-live="polite">@SelectionDescription</p>

    @if (Session.CurrentLayer.Elements.Count == 0)
    {
        <p class="df-canvas-hint">
            Пустой холст. Добавьте блок из палитры или перетащите его сюда.
        </p>
    }
</div>

@code {
    private ElementReference _sheet;
    private IJSObjectReference? _module;
    private DotNetObjectReference<CanvasView>? _self;
    private bool _attached;

    private CanvasGesture _gesture = CanvasGesture.None;
    private ResizeHandle? _handle;
    private Rect _origin;
    private double _startX;
    private double _startY;
    private Dictionary<string, Rect> _dragOrigins = new(StringComparer.Ordinal);
    private Rect? _marquee;
    private string _cursor = "default";
    private string? _placementNotice;
    private double _zoom = 1;
    private bool _hand, _coarse, _fitWidth;
    private void SetZoom(double value) { if (!Session.IsGestureRunning) _zoom = Math.Clamp(value, .1, 2); }
    private void ResetZoom() { _fitWidth = false; SetZoom(1); }
    [JSInvokable] public void ZoomBy(double delta) { _fitWidth = false; SetZoom(_zoom + delta); StateHasChanged(); }
    [JSInvokable] public void OnViewportChanged(double width)
    {
        if (!_fitWidth) return;
        SetZoom(width / Session.CurrentLayer.CanvasWidth);
        StateHasChanged();
    }
    private async Task FitWidth()
    {
        _fitWidth = true;
        if (_module is not null) SetZoom(await _module.InvokeAsync<double>("availableWidth") / Session.CurrentLayer.CanvasWidth);
    }
    private async Task ToggleHand()
    {
        if (Session.IsGestureRunning) return;
        _hand = !_hand;
        if (_module is not null) await _module.InvokeVoidAsync("setHand", _hand);
    }
    private string? _editingId;
    private double? _verticalGuide, _horizontalGuide;
    private int _searchNavigation;
    private bool _searchWasOpen, _restoreSearchFocus;
    private (bool Selection, bool Paste)? _keyboardState;
    private bool CanResize => Session.CanTransformSelection && Session.Members().All(e => e.Rotation == 0);
    private string SelectionDescription => Session.Selected is { } selected
        ? $"{ElementDefaults.NameOf(selected.Kind)}: {selected.DisplayText}. X {Number(selected.X)}, Y {Number(selected.Y)}. Размер {Number(selected.Width)} на {Number(selected.Height)}."
        : $"Выбрано блоков: {Session.Selection.Count}";

    [JSInvokable]
    public async Task SelectAdjacent(bool previous)
    {
        if (Session.IsGestureRunning) return;
        var blocks = TabPanels.Visible(Session.CurrentLayer).ToList();
        if (blocks.Count == 0) return;
        var index = blocks.FindIndex(element => Session.Selection.Contains(element.Id));
        index = index < 0 ? (previous ? blocks.Count - 1 : 0) : (index + (previous ? -1 : 1) + blocks.Count) % blocks.Count;
        Session.Select(blocks[index].Id);
        if (_module is not null) await _module.InvokeVoidAsync("scrollToElement", blocks[index].Id);
    }

    /// <summary>Opens direct text editing for the block under the double click.</summary>
    [JSInvokable]
    public void OnEditText(double x, double y)
    {
        var hit = Session.CurrentLayer.HitTest(x, y);
        if (hit is not null && Session.EnterGroup(hit.Id)) return;
        if (hit is { } element && ElementDefaults.IsTextual(element.Kind))
        {
            Session.Select(element.Id);
            _editingId = element.Id;
            StateHasChanged();
        }
    }

    private void CommitText(string id, string value)
    {
        if (Session.CurrentLayer.Find(id) is not { } element || value == element.DisplayText) return;
        Session.Edit("Текст изменён", _ => element.Text = value);
    }

    private void CloseTextEditor() => _editingId = null;

    /// <summary>
    /// Puts a block on the sheet when the palette was clicked rather than dragged. The blocks land in
    /// a cascade instead of on top of one another, because the second click is almost never meant to
    /// hide the first block.
    /// </summary>
    public void AddCascade(WireframeKind kind)
    {
        _placementNotice = null;
        var selected = Session.Selected;
        var parent = selected is not null && TabPanels.IsContainer(selected.Kind) ? selected :
            selected is null ? null : TabPanels.Parent(Session.CurrentLayer, selected);
        var (width, height) = ElementDefaults.SizeOf(kind);
        Rect area;
        IEnumerable<WireframeElement> siblings;
        if (!TabPanels.IsContainer(kind) && parent is not null)
        {
            var panel = TabPanels.PanelBounds(parent);
            var textHeight = string.IsNullOrWhiteSpace(TabPanels.Content(parent)) ? 0 :
                TabPanels.Content(parent).Split('\n').Length * 18 + 8;
            area = new(panel.X + 12, panel.Y + 12 + textHeight, Math.Max(0, panel.Width - 24), Math.Max(0, panel.Height - 24 - textHeight));
            siblings = Session.CurrentLayer.Elements.Where(element => !element.Hidden && element.ParentTabsId == parent.Id &&
                element.ParentTabIndex == TabPanels.Index(parent));
        }
        else
        {
            parent = null;
            area = new(16, 16, Math.Max(0, Session.CurrentLayer.CanvasWidth - 32), Math.Max(0, Session.CurrentLayer.CanvasHeight - 32));
            siblings = TabPanels.Visible(Session.CurrentLayer);
        }
        var space = CanvasGeometry.FreeSpace(area, width, height, siblings.OrderBy(e => e.ZIndex).Select(e => e.Bounds), Session.Document.GridSize);
        if (space is { } free) { _searchNavigation = -1; Session.Add(kind, free.X, free.Y, parent?.Id); }
        else { _placementNotice = "Нет свободного места для блока. Увеличьте экран или освободите место."; StateHasChanged(); }
    }

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        Session.Changed += OnSessionChanged;
        Session.GestureChanged += OnSessionChanged;
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_restoreSearchFocus) { _restoreSearchFocus = false; await _sheet.FocusAsync(preventScroll: true); }
        if (_module is not null) await UpdateKeyboardState();
        if (!firstRender)
        {
            if(_module is not null && _searchNavigation!=Session.SearchNavigationVersion && Session.Selected is { } found)
            {
                _searchNavigation=Session.SearchNavigationVersion;await _module.InvokeVoidAsync("scrollToElement",found.Id);
            }
            return;
        }

        _module = await Js.InvokeAsync<IJSObjectReference>("import", "./js/draftline-canvas.js");
        _self = DotNetObjectReference.Create(this);

        await _module.InvokeVoidAsync("attach", _sheet, _self);
        await UpdateKeyboardState();
        _coarse = await _module.InvokeAsync<bool>("isCoarsePointer");
        if (_coarse) { _hand = true; await _module.InvokeVoidAsync("setHand", true); }
        if (_coarse || await _module.InvokeAsync<bool>("isCompactViewport")) { await FitWidth(); StateHasChanged(); }
        _attached = true;
    }

    private async Task UpdateKeyboardState()
    {
        var state = (Session.Selection.Count > 0, Session.CanPaste);
        if (_keyboardState == state) return;
        _keyboardState = state;
        await _module!.InvokeVoidAsync("setSelectionState", state.Item1, state.Item2);
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        Session.Changed -= OnSessionChanged;
        Session.GestureChanged -= OnSessionChanged;

        if (_attached && _module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("detach");
            }
            catch (JSDisconnectedException)
            {
                // The page is going away, so there is nothing left to detach from.
            }
        }

        if (_module is not null)
        {
            await _module.DisposeAsync();
            _module = null;
        }

        _self?.Dispose();
        _self = null;
        _attached = false;
    }

    private void OnSessionChanged()
    {
        if (_searchWasOpen && !Session.SearchOpen) _restoreSearchFocus = true;
        _searchWasOpen = Session.SearchOpen;
        InvokeAsync(StateHasChanged);
    }

    // --- what the pointer does -------------------------------------------------------------------

    /// <summary>A press on the sheet: grab a handle, grab a block, or start a selection frame.</summary>
    [JSInvokable]
    public void OnPointerDown(double x, double y, bool additive)
    {
        if (Session.IsGestureRunning) return;
        // A handle of the selected block wins over everything under the pointer: it is small, it is
        // deliberate, and it is drawn on top of whatever it belongs to.
        if (CanResize && Session.SelectionBounds is { } selectedBounds && CanvasInteraction.HandleAt(selectedBounds, x, y, (_coarse ? 22 : 6) / _zoom) is { } handle)
        {
            _gesture = CanvasGesture.Resize;
            _handle = handle;
            _origin = selectedBounds;
            _dragOrigins = Session.Members().ToDictionary(e => e.Id, e => e.Bounds);
            _startX = x;
            _startY = y;
            _cursor = "nwse-resize";
            Session.BeginGesture("Размер изменён");
            return;
        }

        var hit = Session.CurrentLayer.HitTest(x, y);

        if (hit is null)
        {
            Session.ClearSelection();
            _gesture = CanvasGesture.Marquee;
            _startX = x;
            _startY = y;
            _marquee = new Rect(x, y, 0, 0);
            _cursor = "crosshair";
            StateHasChanged();
            return;
        }

        if (additive)
        {
            var ids = Session.Selection.ToList();
            if (!ids.Remove(hit.Id))
            {
                ids.Add(hit.Id);
            }

            Session.SetSelection(ids);
        }
        else if (!Session.Selection.Contains(hit.Id))
        {
            Session.Select(hit.Id);
        }

        if (!Session.CanTransformSelection) { StateHasChanged(); return; }
        _gesture = CanvasGesture.Move;
        _startX = x;
        _startY = y;
        _cursor = "grabbing";
        _dragOrigins = Session.Members()
            .ToDictionary(element => element.Id, element => element.Bounds);

        Session.BeginGesture(Session.Selection.Count > 1 ? "Блоки перемещены" : "Блок перемещён");
        StateHasChanged();
    }

    /// <summary>The pointer moving with the button down: the gesture follows it.</summary>
    [JSInvokable]
    public void OnPointerMove(double x, double y, bool free = false)
    {
        if (_gesture == CanvasGesture.None)
        {
            return;
        }

        var deltaX = x - _startX;
        var deltaY = y - _startY;

        switch (_gesture)
        {
            case CanvasGesture.Move:
                _verticalGuide = _horizontalGuide = null;
                if (!free)
                {
                    var moving = ElementGroups.Bounds(_dragOrigins.Where(pair => Session.CurrentLayer.Find(pair.Key) is not null).Select(pair =>
                    {
                        var e = Session.CurrentLayer.Find(pair.Key)?.Clone() ?? new WireframeElement();
                        e.X = pair.Value.X + deltaX; e.Y = pair.Value.Y + deltaY;
                        return ElementGeometry.DrawingBounds(e);
                    }));
                    var snap = SmartGuides.Snap(moving, TabPanels.Visible(Session.CurrentLayer).Where(e => !_dragOrigins.ContainsKey(e.Id)).Select(ElementGeometry.DrawingBounds), Session.CurrentLayer.CanvasWidth, Session.CurrentLayer.CanvasHeight);
                    deltaX += snap.X; deltaY += snap.Y;
                    _verticalGuide = snap.Vertical; _horizontalGuide = snap.Horizontal;
                }
                var unclamped = (deltaX, deltaY);
                (deltaX, deltaY) = TabPanels.ClampTranslation(_dragOrigins.Values, deltaX, deltaY,
                    Session.CurrentLayer.CanvasWidth, Session.CurrentLayer.CanvasHeight);
                if (unclamped.deltaX != deltaX) _verticalGuide = null;
                if (unclamped.deltaY != deltaY) _horizontalGuide = null;
                Session.Preview(document =>
                {
                    foreach (var (id, origin) in _dragOrigins)
                    {
                        if (Session.CurrentLayer.Find(id) is not { } element)
                        {
                            continue;
                        }

                        var moved = CanvasGeometry.Move(origin, deltaX, deltaY, Session.CurrentLayer.CanvasWidth, Session.CurrentLayer.CanvasHeight);
                        element.X = moved.X;
                        element.Y = moved.Y;
                    }
                });
                break;

            case CanvasGesture.Resize when _handle is { } handle:
                var id = Session.Selection.FirstOrDefault();
                Session.Preview(document =>
                {
                    if (Session.CurrentLayer.Find(id) is not { } element)
                    {
                        return;
                    }

                    if (Session.Selection.Count > 1)
                    {
                        var groupBounds = CanvasInteraction.Resize(_origin, handle, deltaX, deltaY, document.GridSize, Session.CurrentLayer.CanvasWidth, Session.CurrentLayer.CanvasHeight);
                        var sx = Math.Max(groupBounds.Width / _origin.Width, _dragOrigins.Values.Max(r => CanvasGeometry.MinimumSize / r.Width));
                        var sy = Math.Max(groupBounds.Height / _origin.Height, _dragOrigins.Values.Max(r => CanvasGeometry.MinimumSize / r.Height));
                        foreach (var (memberId, original) in _dragOrigins)
                        {
                            if (Session.CurrentLayer.Find(memberId) is not { } member) continue;
                            var scaled = CanvasGeometry.Clamp(new Rect(groupBounds.X+(original.X-_origin.X)*sx,groupBounds.Y+(original.Y-_origin.Y)*sy,original.Width*sx,original.Height*sy),Session.CurrentLayer.CanvasWidth,Session.CurrentLayer.CanvasHeight);
                            (member.X,member.Y,member.Width,member.Height)=(scaled.X,scaled.Y,scaled.Width,scaled.Height);
                        }
                        return;
                    }
                    var resized = CanvasInteraction.Resize(
                        _origin, handle, deltaX, deltaY, document.GridSize, Session.CurrentLayer.CanvasWidth, Session.CurrentLayer.CanvasHeight);
                    resized = ImageAssets.KeepAspect(resized, element, Session.CurrentLayer.CanvasWidth, Session.CurrentLayer.CanvasHeight, handle is ResizeHandle.North or ResizeHandle.South);

                    element.X = resized.X;
                    element.Y = resized.Y;
                    element.Width = resized.Width;
                    element.Height = resized.Height;
                });
                break;

            case CanvasGesture.Marquee:
                _marquee = CanvasInteraction.MarqueeBetween(_startX, _startY, x, y);
                StateHasChanged();
                break;
        }
    }

    /// <summary>The button came up: the gesture ends, and a frame becomes a selection.</summary>
    [JSInvokable]
    public void OnPointerUp(double x, double y)
    {
        switch (_gesture)
        {
            case CanvasGesture.Marquee:
                if (_marquee is { } frame)
                {
                    var caught = TabPanels.Visible(Session.CurrentLayer)
                        .Where(element => CanvasInteraction.Intersects(frame, element.Bounds))
                        .OrderBy(element => element.ZIndex)
                        .Select(element => element.Id)
                        .ToList();

                    Session.SetSelection(caught);
                }

                _marquee = null;
                break;

            case CanvasGesture.Move:
            case CanvasGesture.Resize:
                // One step in the history for the whole drag, not one for every pixel of it.
                Session.EndGesture();
                break;
        }

        _gesture = CanvasGesture.None;
        _handle = null;
        _cursor = "default";
        _dragOrigins.Clear();
        _verticalGuide = _horizontalGuide = null;
        StateHasChanged();
    }

    /// <summary>Something was dropped on the sheet: the block the palette was carrying lands here.</summary>
    [JSInvokable]
    public void OnDrop(double x, double y)
    {
        if (Palette.Take() is not { } kind)
        {
            return;
        }

        // The pointer is the middle of the block, which is where a hand expects the shape to be when
        // it lets go: dropping by the corner leaves every block half off the sheet.
        var (width, height) = ElementDefaults.SizeOf(kind);
        Session.Add(kind, x - (width / 2), y - (height / 2));
        StateHasChanged();
    }

    /// <summary>A key was pressed while the editor is in front of the person.</summary>
    [JSInvokable]
    public bool OnKey(string key, bool shift)
    {
        if (Session.IsGestureRunning) return false;
        var step = CanvasInteraction.NudgeStep(Session.Document.GridSize, shift);

        switch (key)
        {
            case "Search": Session.ShowSearch(); return true;
            case "CloseSearch": Session.CloseSearch(); return true;
            case "EditText":
                if (Session.Selected is not { } textual || !ElementDefaults.IsTextual(textual.Kind)) return false;
                _editingId = textual.Id;
                StateHasChanged();
                return true;
            case "Delete":
                return Session.RemoveSelected();

            case "Copy": return Session.CopySelection();
            case "Cut": return Session.CutSelection();
            case "Paste": return Session.PasteSelection();
            case "Duplicate":
                Session.DuplicateSelected();
                return true;

            case "Undo":
                return Session.Undo();

            case "Redo":
                return Session.Redo();

            case "Group":
                Session.GroupSelected(); return true;
            case "Ungroup":
                Session.UngroupSelected(); return true;
            case "Escape":
                if (Session.LeaveGroup()) return true;
                Session.ClearSelection();
                return true;

            case "Front":
                Session.BringSelectedToFront();
                return true;

            case "Back":
                Session.SendSelectedToBack();
                return true;

            case "Left":
                return Nudge(-step, 0);

            case "Right":
                return Nudge(step, 0);

            case "Up":
                return Nudge(0, -step);

            case "Down":
                return Nudge(0, step);

            default:
                return false;
        }
    }

    private bool Nudge(double deltaX, double deltaY)
    {
        var ids = Session.Members().Select(e => e.Id).ToList();
        if (ids.Count == 0 || !Session.CanTransformSelection)
        {
            return false;
        }

        Session.Edit(ids.Count > 1 ? "Блоки сдвинуты" : "Блок сдвинут", document =>
        {
            (deltaX, deltaY) = TabPanels.ClampTranslation(ids.Select(id => Session.CurrentLayer.Find(id)!.Bounds),
                deltaX, deltaY, Session.CurrentLayer.CanvasWidth, Session.CurrentLayer.CanvasHeight);
            foreach (var id in ids)
            {
                if (Session.CurrentLayer.Find(id) is not { } element)
                {
                    continue;
                }

                var moved = CanvasGeometry.Move(element.Bounds, deltaX, deltaY, Session.CurrentLayer.CanvasWidth, Session.CurrentLayer.CanvasHeight);
                element.X = moved.X;
                element.Y = moved.Y;
            }
        });

        return true;
    }

    // --- how it looks ----------------------------------------------------------------------------

    private string SheetStyle =>
        $"width:{Number(Session.CurrentLayer.CanvasWidth)}px;" +
        $"height:{Number(Session.CurrentLayer.CanvasHeight)}px;" +
        $"zoom:{Number(_zoom)};--df-zoom:{Number(_zoom)};" +
        $"cursor:{_cursor};";

    private static string RectStyle(Rect rect) =>
        $"left:{Number(rect.X)}px;top:{Number(rect.Y)}px;" +
        $"width:{Number(rect.Width)}px;height:{Number(rect.Height)}px;";

    private static string HandleStyle(Rect bounds, double x, double y) =>
        $"left:{Number(x - bounds.X)}px;top:{Number(y - bounds.Y)}px;";

    /// <summary>The class that gives a handle its cursor and its shape, by which edge it drags.</summary>
    private static string HandleClass(ResizeHandle handle) => handle switch
    {
        ResizeHandle.NorthWest => "nw",
        ResizeHandle.North => "n",
        ResizeHandle.NorthEast => "ne",
        ResizeHandle.East => "e",
        ResizeHandle.SouthEast => "se",
        ResizeHandle.South => "s",
        ResizeHandle.SouthWest => "sw",
        _ => "w"
    };

    private static string Number(double value) =>
        value.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
}
