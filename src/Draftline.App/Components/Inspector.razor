@implements IDisposable
@inject DocumentSession Session
@inject DocumentFileService Files

@* The properties of the selected block.
   
   Everything here goes through the session's Edit, so a change made in this panel is a change the
   history can undo and the autosave will write - this is a form over the document, never a second
   editor beside it. Fields update when they lose focus rather than on every keystroke: otherwise one
   word typed into a label would fill the undo history with a dozen steps. *@
@if (Session.Selected is not { } element)
{
    <p class="df-side__hint">Выберите блок на холсте - его свойства появятся здесь.</p>
}
else
{
    <div class="df-inspector">
        <p class="df-inspector__kind">@ElementDefaults.NameOf(element.Kind)</p>

        <div class="df-inspector__pair">
            <FlareNumericField Label="X" Size="FieldSize.Xs" Min="0"
                               Value="@element.X"
                               ValueChanged="@((double? value) => SetX(element, value))" />
            <FlareNumericField Label="Y" Size="FieldSize.Xs" Min="0"
                               Value="@element.Y"
                               ValueChanged="@((double? value) => SetY(element, value))" />
        </div>

        <div class="df-inspector__pair">
            <FlareNumericField Label="Ширина" Size="FieldSize.Xs" Min="@CanvasGeometry.MinimumSize"
                               Value="@element.Width"
                               ValueChanged="@((double? value) => SetWidth(element, value))" />
            <FlareNumericField Label="Высота" Size="FieldSize.Xs" Min="@CanvasGeometry.MinimumSize"
                               Value="@element.Height"
                               ValueChanged="@((double? value) => SetHeight(element, value))" />
        </div>

        @if (ElementDefaults.IsTextual(element.Kind))
        {
            <FlareTextField Label="Текст" Size="FieldSize.Xs"
                            Value="@element.Text"
                            ValueChanged="@((string? value) => SetText(element, value))" />

            <div class="df-inspector__pair">
                <FlareNumericField Label="Масштаб текста" Size="FieldSize.Xs" Min="0.5" Max="4" Step="0.5"
                                   Value="@element.FontScale"
                                   ValueChanged="@((double? value) => SetFontScale(element, value))" />
                <FlareCheckbox Value="@element.Bold" ValueChanged="@((bool value) => SetBold(element, value))">
                    Жирный
                </FlareCheckbox>
            </div>
        }

        @if (ElementDefaults.AcceptsValue(element.Kind))
        {
            <FlareTextField Label="Значение" Size="FieldSize.Xs"
                            Value="@element.Value"
                            ValueChanged="@((string? value) => SetValue(element, value))" />

            <FlareTextField Label="Подсказка" Size="FieldSize.Xs"
                            Value="@element.Placeholder"
                            ValueChanged="@((string? value) => SetPlaceholder(element, value))" />
        }

        @if (ElementDefaults.AcceptsSecondaryText(element.Kind))
        {
            <FlareTextField Label="Вторая строка" Size="FieldSize.Xs"
                            Value="@element.SecondaryText"
                            ValueChanged="@((string? value) => SetSecondaryText(element, value))" />
        }

        @if (ElementDefaults.HasCheck(element.Kind))
        {
            <FlareCheckbox Value="@element.Checked" ValueChanged="@((bool value) => SetChecked(element, value))">
                Отмечено
            </FlareCheckbox>
        }

        @if (ElementDefaults.HasRows(element.Kind))
        {
            <FlareTextArea Label="Пункты, по одному в строке; значение после знака =" Size="FieldSize.Xs"
                           Value="@OptionsText(element)"
                           ValueChanged="@((string? value) => SetOptions(element, value))" />
        }

        @if (element.Kind == WireframeKind.DataGrid)
        {
            <FlareTextArea Label="Колонки, по одной в строке" Size="FieldSize.Xs"
                           Value="@ColumnsText(element)"
                           ValueChanged="@((string? value) => SetColumns(element, value))" />

            <FlareTextArea Label="Строки: ячейки через |" Size="FieldSize.Xs"
                           Value="@RowsText(element)"
                           ValueChanged="@((string? value) => SetRows(element, value))" />
        }

        <p class="df-side__hint">Выравнивание</p>
        <FlareStack Row="true" Gap="FlareSpacing.XSmall" Wrap="true">
            @foreach (var (alignment, caption) in Alignments)
            {
                var target = alignment;
                <FlareButton Variant="ButtonVariant.Text" OnClick="@(() => Align(element, target))">@caption</FlareButton>
            }
        </FlareStack>

        <FlareStack Row="true" Gap="FlareSpacing.XSmall" Wrap="true">
            <FlareButton Variant="ButtonVariant.Text" OnClick="Session.BringSelectedToFront">Поверх</FlareButton>
            <FlareButton Variant="ButtonVariant.Text" OnClick="Session.SendSelectedToBack">Вниз</FlareButton>
        </FlareStack>

        <FlareDivider />

        @if (Session.Document.Layers.Count > 1)
        {
            <FlareSelect Label="Переход при нажатии" Size="FieldSize.Xs"
                         Value="@element.TargetLayerId"
                         ValueChanged="@((string? value) => Session.SetTransition(element, value, IsDialog(element)))">
                <option value="">Нет</option>
                @foreach (var layer in Session.Document.Layers)
                {
                    <option value="@layer.Id">@layer.Name</option>
                }
            </FlareSelect>

            @if (element.HasTransition)
            {
                <FlareCheckbox Value="@IsDialog(element)"
                               ValueChanged="@((bool value) => Session.SetTransition(element, element.TargetLayerId, value))">
                    Открывать диалогом
                </FlareCheckbox>
            }
        }

        <FlareButton Variant="ButtonVariant.Outlined"
                     OnClick="@(() => Files.DownloadSvgAsync(Session.Document, Session.CurrentLayer, element))">
            Выгрузить этот блок в SVG
        </FlareButton>
    </div>
}

@code {
    private static readonly (ElementAlignment Alignment, string Caption)[] Alignments =
    {
        (ElementAlignment.Left, "Влево"),
        (ElementAlignment.CenterHorizontally, "По центру"),
        (ElementAlignment.Right, "Вправо"),
        (ElementAlignment.Top, "Вверх"),
        (ElementAlignment.CenterVertically, "По середине"),
        (ElementAlignment.Bottom, "Вниз"),
        (ElementAlignment.MatchWidth, "Во всю ширину"),
        (ElementAlignment.MatchHeight, "Во всю высоту")
    };

    /// <inheritdoc />
    protected override void OnInitialized() => Session.Changed += OnStateChanged;

    /// <inheritdoc />
    public void Dispose() => Session.Changed -= OnStateChanged;

    /// <summary>The rows of a list or a dropdown, one per line - the way a person writes a list.</summary>
    private static string OptionsText(WireframeElement element) => string.Join('\n', element.Options);

    /// <summary>The columns of a table, one per line.</summary>
    private static string ColumnsText(WireframeElement element) => string.Join('\n', element.Columns);

    /// <summary>The rows of a table, one per line, with the cells separated by a bar.</summary>
    private static string RowsText(WireframeElement element) =>
        string.Join('\n', element.Rows.Select(row => string.Join(" | ", row)));

    /// <summary>One entry per line, with the empty lines dropped.</summary>
    private static List<string> LinesOf(string? value) =>
        (value ?? string.Empty)
            .Split('\n')
            .Select(line => line.Trim())
            .Where(line => line.Length > 0)
            .ToList();

    private void SetColumns(WireframeElement element, string? value)
    {
        var columns = LinesOf(value);
        if (columns.SequenceEqual(element.Columns))
        {
            return;
        }

        Apply(element, "Колонки изменены", target => target.Columns = columns);
    }

    private void SetRows(WireframeElement element, string? value)
    {
        var rows = LinesOf(value)
            .Select(line => line.Split('|').Select(cell => cell.Trim()).ToList())
            .ToList();

        // The table is kept a rectangle right here as well as on read: a row with fewer cells than the
        // header is padded and a longer one is cut, which is the same rule the document applies when a
        // file is opened.
        var columns = element.Columns.Count;
        if (columns > 0)
        {
            foreach (var row in rows)
            {
                while (row.Count < columns)
                {
                    row.Add(string.Empty);
                }

                while (row.Count > columns)
                {
                    row.RemoveAt(row.Count - 1);
                }
            }
        }

        if (rows.Count == element.Rows.Count
            && rows.Zip(element.Rows).All(pair => pair.First.SequenceEqual(pair.Second)))
        {
            return;
        }

        Apply(element, "Строки таблицы изменены", target => target.Rows = rows);
    }

    private void SetX(WireframeElement element, double? value)
    {
        if (value is not { } x || Math.Abs(x - element.X) < 0.001)
        {
            return;
        }

        Apply(element, "Положение изменено", target => target.X = x);
    }

    private void SetY(WireframeElement element, double? value)
    {
        if (value is not { } y || Math.Abs(y - element.Y) < 0.001)
        {
            return;
        }

        Apply(element, "Положение изменено", target => target.Y = y);
    }

    private void SetWidth(WireframeElement element, double? value)
    {
        if (value is not { } width || Math.Abs(width - element.Width) < 0.001)
        {
            return;
        }

        Apply(element, "Размер изменён", target => target.Width = Math.Max(CanvasGeometry.MinimumSize, width));
    }

    private void SetHeight(WireframeElement element, double? value)
    {
        if (value is not { } height || Math.Abs(height - element.Height) < 0.001)
        {
            return;
        }

        Apply(element, "Размер изменён", target => target.Height = Math.Max(CanvasGeometry.MinimumSize, height));
    }

    private void SetText(WireframeElement element, string? value)
    {
        var text = value ?? string.Empty;
        if (text == element.Text)
        {
            return;
        }

        Apply(element, "Текст изменён", target => target.Text = text);
    }

    /// <summary>True when the block opens its target as a dialog over the screen, not in its place.</summary>
    private static bool IsDialog(WireframeElement element) =>
        element.Transition == TransitionKind.OpenDialog;

    private void SetFontScale(WireframeElement element, double? value)
    {
        if (value is not { } scale || Math.Abs(scale - element.FontScale) < 0.001)
        {
            return;
        }

        Apply(element, "Масштаб текста изменён", target => target.FontScale = Math.Clamp(scale, 0.5, 4));
    }

    private void SetValue(WireframeElement element, string? value)
    {
        var text = value ?? string.Empty;
        if (text == element.Value)
        {
            return;
        }

        Apply(element, "Значение изменено", target => target.Value = text);
    }

    private void SetPlaceholder(WireframeElement element, string? value)
    {
        var text = value ?? string.Empty;
        if (text == element.Placeholder)
        {
            return;
        }

        Apply(element, "Подсказка изменена", target => target.Placeholder = text);
    }

    private void SetSecondaryText(WireframeElement element, string? value)
    {
        var text = value ?? string.Empty;
        if (text == element.SecondaryText)
        {
            return;
        }

        Apply(element, "Вторая строка изменена", target => target.SecondaryText = text);
    }

    private void SetBold(WireframeElement element, bool value)
    {
        if (value == element.Bold)
        {
            return;
        }

        Apply(element, "Жирность изменена", target => target.Bold = value);
    }

    private void SetChecked(WireframeElement element, bool value)
    {
        if (value == element.Checked)
        {
            return;
        }

        Apply(element, "Отметка изменена", target => target.Checked = value);
    }

    private void SetOptions(WireframeElement element, string? value)
    {
        var options = (value ?? string.Empty)
            .Split('\n')
            .Select(line => line.Trim())
            .Where(line => line.Length > 0)
            .ToList();

        if (options.SequenceEqual(element.Options))
        {
            return;
        }

        Apply(element, "Пункты изменены", target => target.Options = options);
    }

    private void Align(WireframeElement element, ElementAlignment alignment) =>
        Apply(element, "Выравнивание", target =>
        {
            var aligned = CanvasGeometry.Align(
                target.Bounds,
                alignment,
                Session.Document.GridSize,
                Session.CurrentLayer.CanvasWidth,
                Session.CurrentLayer.CanvasHeight);

            target.X = aligned.X;
            target.Y = aligned.Y;
            target.Width = aligned.Width;
            target.Height = aligned.Height;
        });

    /// <summary>Changes the block inside the document, through the one door it has.</summary>
    private void Apply(WireframeElement element, string label, Action<WireframeElement> change) =>
        Session.Edit(label, document =>
        {
            if (Session.CurrentLayer.Find(element.Id) is { } target)
            {
                change(target);
            }
        });

    private void OnStateChanged() => InvokeAsync(StateHasChanged);
}
