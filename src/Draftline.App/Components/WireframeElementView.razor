@* One block, drawn the Draftline way: a rectangle, a line and a word - and nothing that pretends to
   be a finished design. Every kind is a few spans; the classes live in draftline.css, so the low-fi
   look (straight corners, no gradients, no shadows, hatching instead of a picture) is in one place
   and the same for the canvas, a future preview and the SVG export's reference. *@
<div class="@CssClass" style="@Style" data-element-id="@Element.Id">
    @switch (Element.Kind)
    {
        case WireframeKind.Panel:
            @if (!string.IsNullOrWhiteSpace(Element.Text))
            {
                <span class="df-panel__label">@Element.Text</span>
            }
            @if (!string.IsNullOrWhiteSpace(Element.SecondaryText))
            {
                <span class="df-panel__description">@Element.SecondaryText</span>
            }
            break;

        case WireframeKind.Heading:
            <span class="df-heading">@Element.DisplayText</span>
            break;

        case WireframeKind.Text:
            <span class="df-text-block">
                <span class="df-text">@Element.DisplayText</span>
                @if (!string.IsNullOrWhiteSpace(Element.SecondaryText))
                {
                    <span class="df-text__secondary">@Element.SecondaryText</span>
                }
            </span>
            break;

        case WireframeKind.Button:
            <span class="df-button">@Element.DisplayText</span>
            break;

        case WireframeKind.TextField:
            <span class="df-field__label">@Element.DisplayText</span>
            <span class="@ValueClass">@Element.DisplayValue</span>
            <span class="df-field__line"></span>
            break;

        case WireframeKind.TextArea:
            <span class="df-field__label">@Element.DisplayText</span>
            @if (!string.IsNullOrWhiteSpace(Element.Value))
            {
                <span class="df-area__value">@Element.Value</span>
            }
            <span class="df-area__rules"></span>
            break;

        case WireframeKind.Checkbox:
            @if (Interactive)
            {
                <button type="button" class="df-check-control df-state-button" role="checkbox"
                        aria-checked="@(Element.Checked ? "true" : "false")" disabled="@Element.Disabled" @onclick="ToggleChecked">
                    <span class="df-check@(Element.Checked ? " df-check--on" : string.Empty)" aria-hidden="true"></span>
                    @Element.DisplayText
                </button>
            }
            else
            {
            <span class="df-check@(Element.Checked ? " df-check--on" : string.Empty)"></span>
            <span class="df-check__label">@Element.DisplayText</span>
            }
            break;

        case WireframeKind.Radio:
            @if (Interactive)
            {
                <button type="button" class="df-check-control df-state-button" role="radio"
                        aria-checked="@(Element.Checked ? "true" : "false")" disabled="@Element.Disabled" @onclick="ToggleChecked">
                    <span class="df-radio@(Element.Checked ? " df-radio--on" : string.Empty)" aria-hidden="true"></span>
                    @Element.DisplayText
                </button>
            }
            else
            {
            <span class="df-radio@(Element.Checked ? " df-radio--on" : string.Empty)"></span>
            <span class="df-check__label">@Element.DisplayText</span>
            }
            break;

        case WireframeKind.Select:
            @if (Interactive)
            {
                <button type="button" class="df-select__head df-state-button" disabled="@Element.Disabled"
                        aria-label="@(string.IsNullOrWhiteSpace(ElementState.DisplayChoice(Element)) ? "Выпадающий список" : ElementState.DisplayChoice(Element))" aria-expanded="@(ElementState.IsExpanded(Element) ? "true" : "false")"
                        aria-controls="@("df-options-" + Element.Id)" @onclick="ToggleExpanded">
                    <span class="@ValueClass">@ElementState.DisplayChoice(Element)</span>
                    <span class="df-select__arrow" aria-hidden="true">@(ElementState.IsExpanded(Element) ? "▴" : "▾")</span>
                </button>
            }
            else
            {
            <span class="df-select__head">
            <span class="@ValueClass">@ElementState.DisplayChoice(Element)</span>
            <span class="df-select__arrow">@(ElementState.IsExpanded(Element) ? "▴" : "▾")</span>
            </span>
            }
            @if (ElementState.IsExpanded(Element))
            {
                <span class="df-select__options" id="@("df-options-" + Element.Id)">
                    @for (var index = 0; index < ElementState.Items(Element).Count; index++)
                    {
                        var row = ElementDefaults.SplitOption(ElementState.Items(Element)[index]);
                        @Choice(index, "df-select__option", row.Label + (string.IsNullOrEmpty(row.Value) ? "" : " · " + row.Value))
                    }
                </span>
            }
            break;

        case WireframeKind.List:
            @for (var index = 0; index < ElementState.Items(Element).Count; index++)
            {
                var (label, value) = ElementDefaults.SplitOption(ElementState.Items(Element)[index]);
                @Choice(index, "df-list__row", label + (string.IsNullOrEmpty(value) ? "" : " · " + value))
            }
            break;

        case WireframeKind.Image:
            <span class="df-image__cross"></span>
            @if (!string.IsNullOrWhiteSpace(Element.Text))
            {
                <span class="df-image__caption">@Element.Text</span>
            }
            break;

        case WireframeKind.Divider:
            break;

        case WireframeKind.DataGrid:
            <span class="df-table">
                <span class="df-table__row df-table__head">
                    @foreach (var column in Element.Columns)
                    {
                        <span class="df-table__cell">@column</span>
                    }
                </span>
                @foreach (var row in Element.Rows)
                {
                    <span class="df-table__row">
                        @foreach (var cell in row)
                        {
                            <span class="df-table__cell">@cell</span>
                        }
                    </span>
                }
            </span>
            break;

        case WireframeKind.Tabs:
            <div class="df-tabs__headers" role="tablist" aria-label="@(string.IsNullOrWhiteSpace(Element.Text) ? "Вкладки" : Element.Text)">
                @for (var index = 0; index < ElementState.Items(Element).Count; index++)
                {
                    var tabIndex = index;
                    var label = ElementDefaults.SplitOption(ElementState.Items(Element)[index]).Label;
                    @if (Interactive || Authoring)
                    {
                        <button type="button" role="tab" class="df-tabs__tab @SelectedClass(index) df-state-button"
                                @ref="_tabHeaders[tabIndex]" tabindex="@(ElementState.Index(Element) == index ? 0 : -1)"
                                id="@($"df-tab-{Element.Id}-{index}")" aria-selected="@(ElementState.Index(Element) == index ? "true" : "false")"
                                aria-controls="@("df-panel-" + Element.Id)" disabled="@(Interactive && Element.Disabled)"
                                @onclick="() => ChooseTab(tabIndex)" @onkeydown="args => OnTabKey(args, tabIndex)">@label</button>
                    }
                    else
                    {
                        <span class="df-tabs__tab @SelectedClass(index)">@label</span>
                    }
                }
            </div>
            <div class="df-tabs__panel" role="tabpanel" id="@("df-panel-" + Element.Id)"
                 aria-labelledby="@($"df-tab-{Element.Id}-{ElementState.Index(Element)}")">@TabPanels.Content(Element)</div>
            break;

        case WireframeKind.MenuBar:
            @for (var index = 0; index < ElementState.Items(Element).Count; index++)
            {
                @Choice(index, "df-menu__item", ElementDefaults.SplitOption(ElementState.Items(Element)[index]).Label)
            }
            break;

        case WireframeKind.Accordion:
            @for (var index = 0; index < ElementState.Items(Element).Count; index++)
            {
                var opened = ElementState.IsExpanded(Element) && index == Math.Max(0, ElementState.Index(Element));
                @Choice(index, "df-accordion__section", (opened ? "− " : "+ ") + ElementDefaults.SplitOption(ElementState.Items(Element)[index]).Label)
                @if (opened)
                {
                    <span class="df-accordion__body">@(string.IsNullOrWhiteSpace(Element.SecondaryText) ? "Содержимое раздела" : Element.SecondaryText)</span>
                }
            }
            break;

        case WireframeKind.Tree:
            @for (var index = 0; index < ElementState.Items(Element).Count; index++)
            {
                if (index > 0 && !ElementState.IsExpanded(Element)) break;
                @Choice(index, "df-tree__item", (index == 0 ? (ElementState.IsExpanded(Element) ? "▾ " : "▸ ") : "") + ElementDefaults.SplitOption(ElementState.Items(Element)[index]).Label)
            }
            break;

        case WireframeKind.Progress:
            <span class="df-progress__fill" style="@FillStyle"></span>
            break;

        case WireframeKind.Slider:
            <span class="df-slider__track"></span>
            <span class="df-slider__handle" style="@HandleStyle"></span>
            break;

        case WireframeKind.Badge:
            <span class="df-badge">@Element.DisplayText</span>
            break;

        case WireframeKind.Avatar:
            <span class="df-avatar">@Element.DisplayText</span>
            break;

        case WireframeKind.Calendar:
            <span class="df-calendar__title">@Element.DisplayText</span>
            <span class="df-calendar__grid">
                @for (var day = 1; day <= 28; day++)
                {
                    <span class="df-calendar__day">@day</span>
                }
            </span>
            break;

        case WireframeKind.Map:
            <span class="df-map__road df-map__road--one"></span>
            <span class="df-map__road df-map__road--two"></span>
            <span class="df-map__pin"></span>
            break;

        case WireframeKind.Video:
            <span class="df-video__play">▶</span>
            break;

        case WireframeKind.Breadcrumbs:
            @foreach (var (label, _) in Rows)
            {
                <span class="df-crumbs__item">@label</span>
            }
            break;

        case WireframeKind.StatusBar:
            @foreach (var (label, _) in Rows)
            {
                <span class="df-status__item">@label</span>
            }
            break;
    }
</div>

@code {
    /// <summary>The block this view draws.</summary>
    [Parameter, EditorRequired]
    public WireframeElement Element { get; set; } = null!;

    /// <summary>Enables interaction with a preview-owned copy; the authoring canvas remains a drawing.</summary>
    [Parameter] public bool Interactive { get; set; }

    /// <summary>Allows choosing an authored tab from its header on the editing canvas.</summary>
    [Parameter] public bool Authoring { get; set; }
    /// <summary>Receives a tab choice to record through DocumentSession.</summary>
    [Parameter] public EventCallback<int> TabSelected { get; set; }
    /// <summary>The resolved drawing order, keeping group backgrounds behind their children.</summary>
    [Parameter] public int? DrawingOrder { get; set; }

    private ElementReference[] _tabHeaders = Array.Empty<ElementReference>();

    protected override void OnParametersSet()
    {
        if (Element.Kind == WireframeKind.Tabs && _tabHeaders.Length != ElementState.Items(Element).Count)
            _tabHeaders = new ElementReference[ElementState.Items(Element).Count];
    }

    private async Task OnTabKey(KeyboardEventArgs args, int current)
    {
        var count = ElementState.Items(Element).Count;
        var next = args.Key switch
        {
            "ArrowRight" => (current + 1) % count,
            "ArrowLeft" => (current + count - 1) % count,
            "Home" => 0,
            "End" => count - 1,
            _ => -1
        };
        if (next < 0 || (Interactive && Element.Disabled)) return;
        await ChooseTab(next);
        await _tabHeaders[next].FocusAsync(preventScroll: true);
    }

    /// <summary>Notifies the preview after a temporary state change.</summary>
    [Parameter] public EventCallback StateChanged { get; set; }

    private RenderFragment Choice(int index, string css, string label) => @<text>
        @if (Interactive)
        {
            <button type="button" class="@css @SelectedClass(index) df-state-button" disabled="@Element.Disabled"
                    aria-pressed="@(ElementState.Index(Element) == index ? "true" : "false")"
                    aria-expanded="@DisclosureState(index)"
                    @onclick="() => Choose(index)">@label</button>
        }
        else
        {
            <span class="@css @SelectedClass(index)">@label</span>
        }
    </text>;

    private string? DisclosureState(int index) => Element.Kind switch
    {
        WireframeKind.Accordion => ElementState.IsExpanded(Element) && index == Math.Max(0, ElementState.Index(Element)) ? "true" : "false",
        WireframeKind.Tree when index == 0 => ElementState.IsExpanded(Element) ? "true" : "false",
        _ => null
    };

    private async Task Choose(int index)
    {
        if (!Interactive || Element.Disabled) return;
        if (Element.Kind == WireframeKind.Accordion)
            Element.Expanded = Element.SelectedIndex != index || !ElementState.IsExpanded(Element);
        if (Element.Kind == WireframeKind.Tree && index == 0)
            Element.Expanded = !ElementState.IsExpanded(Element);
        Element.SelectedIndex = index;
        if (Element.Kind == WireframeKind.Select) Element.Expanded = false;
        await StateChanged.InvokeAsync();
    }

    private Task ChooseTab(int index) => Authoring ? TabSelected.InvokeAsync(index) : Choose(index);

    private async Task ToggleExpanded()
    {
        if (!Interactive || Element.Disabled) return;
        Element.Expanded = !ElementState.IsExpanded(Element);
        await StateChanged.InvokeAsync();
    }

    private async Task ToggleChecked()
    {
        if (!Interactive || Element.Disabled) return;
        Element.Checked = Element.Kind == WireframeKind.Radio || !Element.Checked;
        await StateChanged.InvokeAsync();
    }

    /// <summary>The classes that say which block this is and how its text is set.</summary>
    private string CssClass
    {
        get
        {
            var css = "df-el df-el--" + Element.Kind.ToString().ToLowerInvariant();
            if (Element.Disabled) css += " df-el--disabled";
            if (Element.Kind == WireframeKind.Select && ElementState.IsExpanded(Element)) css += " df-el--open";
            return Element.Bold ? css + " df-el--bold" : css;
        }
    }

    private IEnumerable<(string Label, string Value)> Rows =>
        (Element.Options.Count > 0 ? Element.Options : ElementDefaults.DefaultOptions)
        .Select(ElementDefaults.SplitOption);

    /// <summary>The class of a value: a hint is drawn lighter than something someone actually typed.</summary>
    private string ValueClass => Element.ShowsHint && ElementState.Index(Element) < 0 ? "df-field__value df-field__value--hint" : "df-field__value";

    private string SelectedClass(int index) => ElementState.Index(Element) == index ? "df-item--selected" : string.Empty;

    /// <summary>
    /// The share of its range a bar or a slider shows, as a percentage between 0 and 100. An empty or
    /// unreadable value means the middle of the range, which is what the block lands with.
    /// </summary>
    private string PercentText
    {
        get
        {
            var percent = 60d;

            if (double.TryParse(
                    Element.Value,
                    System.Globalization.NumberStyles.Float,
                    System.Globalization.CultureInfo.InvariantCulture,
                    out var parsed))
            {
                percent = Math.Clamp(parsed, 0, 100);
            }

            return percent.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
        }
    }

    private string FillStyle => "width:" + PercentText + "%;";

    private string HandleStyle => "left:" + PercentText + "%;";

    private string Style
    {
        get
        {
            var style =
                $"left:{Element.X.ToString(System.Globalization.CultureInfo.InvariantCulture)}px;" +
                $"top:{Element.Y.ToString(System.Globalization.CultureInfo.InvariantCulture)}px;" +
                $"width:{Element.Width.ToString(System.Globalization.CultureInfo.InvariantCulture)}px;" +
                $"height:{Element.Height.ToString(System.Globalization.CultureInfo.InvariantCulture)}px;" +
                $"z-index:{(Element.Kind == WireframeKind.Select && ElementState.IsExpanded(Element) ? 10000 : 0) + (DrawingOrder ?? Element.ZIndex)};";

            if (Math.Abs(Element.FontScale - 1) > 0.001)
            {
                var size = Math.Round(12 * Element.FontScale, 1)
                    .ToString(System.Globalization.CultureInfo.InvariantCulture);
                style += $"font-size:{size}px;";
            }

            return style;
        }
    }
}
