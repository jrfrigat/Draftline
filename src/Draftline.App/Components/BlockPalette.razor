@inject PaletteDrag Palette

@* The shelf of blocks. Each one is a button that puts the block on the sheet and a grip that drags it
   to the spot it belongs in: clicking when you are arranging things, dragging when you already know
   where the block goes. Both exist because both are how people work, and neither is a mode. *@
<div class="df-palette">
    <FlareTextField Variant="InputVariant.Outlined" Label="Найти блок" Immediate="true" Size="FieldSize.Xs" Value="@_query" ValueChanged="@((string? value) => _query = value ?? "")" />
    @if (!ElementDefaults.Sections.SelectMany(section => section.Kinds).Any(Matches))
    {
        <p class="df-hint" role="status">Ничего не найдено. Измените запрос.</p>
    }
    @foreach (var (title, kinds) in ElementDefaults.Sections)
    {
        @if (!kinds.Any(Matches)) { continue; }
        <p class="df-palette__section">@title</p>

        @foreach (var kind in kinds.Where(Matches))
        {
            var item = kind;
            <div class="df-palette__row">
                <button type="button" class="df-palette__button" @onclick="() => AddRequested.InvokeAsync(item)">
                    <span class="df-palette__glyph" aria-hidden="true"><WireframeIconView Key="@IconOf(item)" /></span>
                    <span class="df-palette__name">@ElementDefaults.NameOf(item)</span>
                </button>
                <span class="df-palette__grip"
                      draggable="true"
                      title="Перетащите блок на холст"
                      @ondragstart="() => Palette.Start(item)"
                      @ondragend="Palette.End"
                      aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><circle cx="8" cy="5" r="1.5"/><circle cx="16" cy="5" r="1.5"/><circle cx="8" cy="12" r="1.5"/><circle cx="16" cy="12" r="1.5"/><circle cx="8" cy="19" r="1.5"/><circle cx="16" cy="19" r="1.5"/></svg></span>
            </div>
        }
    }
</div>

@code {
    private string _query = "";
    private bool Matches(WireframeKind kind) => ElementDefaults.NameOf(kind).Contains(_query, StringComparison.OrdinalIgnoreCase);
    /// <summary>Raised when a block was asked for; the canvas decides where it lands.</summary>
    [Parameter, EditorRequired]
    public EventCallback<WireframeKind> AddRequested { get; set; }

    /// <summary>Local SVG symbols with a shared stroke and coordinate system.</summary>
    private static string IconOf(WireframeKind kind) => kind switch
    {
        WireframeKind.Text or WireframeKind.TextArea or WireframeKind.List or WireframeKind.MenuBar or WireframeKind.Accordion => "menu",
        WireframeKind.Heading or WireframeKind.TextField or WireframeKind.RichTextEditor => "edit",
        WireframeKind.Checkbox => "check",
        WireframeKind.Radio or WireframeKind.Tooltip or WireframeKind.Popover => "info",
        WireframeKind.Select or WireframeKind.Scrollbar => "arrow-down",
        WireframeKind.Image or WireframeKind.Camera or WireframeKind.CoverFlow => "image",
        WireframeKind.Divider or WireframeKind.Progress or WireframeKind.Slider => "minus",
        WireframeKind.DataGrid or WireframeKind.Calendar or WireframeKind.DatePicker => "calendar",
        WireframeKind.Tree or WireframeKind.Tabs => "folder",
        WireframeKind.Badge or WireframeKind.Icon => "star",
        WireframeKind.Avatar => "user",
        WireframeKind.Map => "home",
        WireframeKind.Video or WireframeKind.AudioPlayer => "play",
        WireframeKind.Breadcrumbs or WireframeKind.Arrow or WireframeKind.SiteMap => "arrow-right",
        WireframeKind.TimePicker => "clock",
        WireframeKind.Stepper => "plus",
        _ => "file"
    };
}
