<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- xunit.v3 supplies the process entry point and refuses to build a test project that is not
         executable; the Microsoft.Testing.Platform runner global.json selects then drives it. -->
    <OutputType>Exe</OutputType>
    <!-- Without this "dotnet test" starts the assembly and reports zero tests: this is the opt-in that
         makes the command forward to the test application instead of to VSTest. -->
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <!-- The specs build the app's own types, and those are written against the Blazor runtime
         (IComponent, NavigationManager, IJSRuntime), so the shared framework has to be referable
         from here as well. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- xunit.v3 alone: the test project is a Microsoft.Testing.Platform application and global.json
         chooses that platform as the runner. Microsoft.NET.Test.Sdk and the VSTest adapter are
         deliberately not referenced - they are the other path, and mixing the two leaves "dotnet test"
         starting the assembly and finding no tests in it. -->
    <PackageReference Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Draftline.App\Draftline.App.csproj" />
  </ItemGroup>

</Project>
